# Supabase-dashboard → Project Settings → API (of "Connect")
VITE_SUPABASE_URL=https://jouw-project-ref.supabase.co
# De anon key of de publishable key (sb_publishable_…); allebei goed
VITE_SUPABASE_ANON_KEY=
# Optioneel, voor pushmeldingen (npx web-push generate-vapid-keys → public key)
VITE_VAPID_PUBLIC_KEY=
# Optioneel: Sentry-project → Settings → Client Keys (DSN). Leeg = geen foutmeldingen verstuurd.
VITE_SENTRY_DSN=
# Welke omgeving dit is (staat als tag bij elke Sentry-melding); production | weekend | development
VITE_APP_ENV=production
